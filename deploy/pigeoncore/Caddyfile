{
	# 2026-10-04: the pigeon OpenChamber stack is retired. Its config
	# (openchamber.pigeontech.cn / oc.pigeontech.cn / office.pigeontech.cn)
	# is preserved in the snapshot at snapshot/2026-10-04-preclean/etc/caddy/.
	#
	# 2026-10-04: this host now carries the T3 Code workbench (t3.pigeontech.cn).
	#
	# 2026-10-06: h3 enabled. Clients reach this box from China at a measured
	# ~120 ms RTT, so a repeat visit over TCP pays a handshake that QUIC can
	# resume without a round trip, and QUIC does not head-of-line block when the
	# path drops packets. udp/443 was already open in ufw; nothing was listening.
	servers {
		protocols h1 h2 h3
	}
}

t3.pigeontech.cn {
	encode zstd gzip

	# Local ACP Registry index. T3 refuses a registry URL that is not HTTPS, so
	# a self-hosted index has to be served over TLS; this is that route. The file
	# is static and lists agents, nothing sensitive. Built by
	# deploy/agents/build-registry.mjs and pushed by the deploy script.
	handle /acp-registry.json {
		root * /srv/acp
		header Cache-Control "no-cache"
		file_server
	}

	# Hashed build output never changes under the same name.
	#
	# 2026-10-06: served off disk instead of through the Node server. Node reads
	# these in 64 KiB chunks on its own event loop, and the measured tail was a
	# p95 of 6.9 s against a 73 ms median. A first load pulls ~1.4 MiB across 144
	# files, which is exactly the traffic that should not share that loop. A
	# missing asset now 404s rather than silently falling back to index.html.
	@assets path /assets/*

	# Encoding sidecars are not routes of their own; without this a request for
	# /assets/app.js.br would be served as an opaque file. Listed before @assets
	# because mutually exclusive handles are evaluated in declaration order.
	@precompressedSidecar path_regexp \.(br|gz|zst)$
	handle @precompressedSidecar {
		respond 404
	}

	handle @assets {
		root * /opt/t3/dist/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			# Produced at deploy time by deploy/pigeoncore/lib/precompress.mjs,
			# which compresses at quality 11; Caddy's on-the-fly encoder measured
			# ~20% larger. Falls back to the original file with on-the-fly encode
			# whenever a sidecar is missing.
			precompressed br gzip
		}
	}

	# Everything else: the server owns caching, auth and the WebSocket upgrade.
	# flush_interval -1 keeps streamed responses from being buffered; the
	# WebSocket upgrade itself is handled by reverse_proxy automatically.
	handle {
		reverse_proxy 127.0.0.1:3773 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	log {
		output file /var/log/caddy/t3.pigeontech.cn.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
