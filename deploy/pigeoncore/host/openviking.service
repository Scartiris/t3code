[Unit]
Description=OpenViking workbench memory backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
WorkingDirectory=/opt/openviking
ExecStart=/opt/openviking/venv/bin/openviking-server --config /opt/openviking/etc/ov.conf
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
SyslogIdentifier=openviking

[Install]
WantedBy=multi-user.target
