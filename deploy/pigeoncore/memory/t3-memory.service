[Unit]
Description=T3 Memory service (unified agent memory)
Documentation=https://github.com/Scartiris/t3code
After=network-online.target
Wants=network-online.target
# Reachable on purpose: the stock 10s/5 window cannot fill at RestartSec=5, so a
# permanent fault would restart forever instead of landing in `failed`.
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
WorkingDirectory=/opt/t3-memory
Environment=MEMORY_HOME=/opt/t3-memory/home
# Wildcard bind: loopback keeps serving the workbench at 127.0.0.1, and the
# tailnet reaches it at 100.121.96.26. What may actually connect is decided by
# the IPAddressAllow list below, not by the bind address.
Environment=MEMORY_HOST=0.0.0.0
Environment=MEMORY_PORT=3211
Environment=MEMORY_TOKEN_FILE=/opt/t3-memory/token
Environment=NODE_ENV=production
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node24/bin/node /opt/t3-memory/dist/bin.mjs serve
Restart=always
RestartSec=5
# The store is a few megabytes of SQLite and serves one box; these sit far above
# it and far below what the workbench beside it needs.
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=256M
CPUWeight=20
IOWeight=20
TasksMax=256
OOMPolicy=stop
# Serves loopback (the workbench) and the tailnet (every agent CLI that
# attaches this memory directly) and nothing else: the deny is enforced per
# cgroup in both directions, so the public interface never completes a
# handshake. A bearer token still gates every route behind that. Enabling a
# hosted embedding or extraction endpoint later means adding it here too.
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=100.64.0.0/10
SyslogIdentifier=t3-memory

[Install]
WantedBy=multi-user.target
